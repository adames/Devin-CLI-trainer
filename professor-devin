#!/usr/bin/env bash
set -eu

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
    link_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)
    source_path=$(readlink "$source_path")
    case "$source_path" in
        /*) ;;
        *) source_path="$link_dir/$source_path" ;;
    esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)

if ! command -v python3 >/dev/null 2>&1; then
    printf 'Professor Devin needs Python 3. On macOS run: xcode-select --install\n' >&2
    exit 1
fi

exec python3 "$script_dir/dojo/dojo.py" "$@"
